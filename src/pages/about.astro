---
import { getEntry, render } from "astro:content"
import Base from "../layouts/Base.astro"
import { fullDate } from "../lib/format"

const entry = (await getEntry("pages", "about"))!
const { Content } = await render(entry)
---

<Base title={entry.data.title}>
  <div class="page-head" data-edit-type="pages" data-edit-path="src/content/pages/about.md">
    <h1>{entry.data.title}</h1>
    {entry.data.updated && <p class="meta">Last updated {fullDate(entry.data.updated)}</p>}
  </div>
  <div class="prose"><Content /></div>
</Base>
