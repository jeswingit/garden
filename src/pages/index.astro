---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import PostList from "../components/PostList.astro"
import site from "../data/site.json"

const posts = (await getCollection("writing", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)

const more = [
  { href: "/notes/", title: "Digital Garden", text: "Interconnected notes and ideas" },
  { href: "/projects/", title: "Projects", text: "Things I've built" },
  { href: "/now/", title: "Now", text: "What I'm focused on right now" },
  { href: "/about/", title: "About", text: "A bit more about me" },
]
---

<Base>
  <section class="hero" data-edit-type="site" data-edit-path="src/data/site.json">
    <div class="hero-text">
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="bio">{site.bio}</p>
      <div class="buttons">
        {site.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}
      </div>
    </div>
    {site.photo && <img class="hero-photo" src={site.photo} alt={site.name} width="320" />}
  </section>

  <section>
    <h2><span class="sigil">~</span> Writing</h2>
    {posts.length ? <PostList posts={posts} /> : <p class="dim">Nothing published yet.</p>}
    <p><a class="more-link" href="/writing/">All posts →</a></p>
  </section>

  <section>
    <h2><span class="sigil">#</span> More</h2>
    <div class="cards">
      {
        more.map((m) => (
          <a class="card" href={m.href}>
            <strong>{m.title}</strong>
            <span>{m.text}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
